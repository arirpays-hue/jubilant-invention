<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- כותרת עליונה קבועה -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#161B26"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:strokeColor="#00E676"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOUND BOOSTER PRO HD"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="מנוע DSP HD פעיל ● ללא איבוד איכות"
                    android:textColor="#00E676"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:scaleX="1.2"
                android:scaleY="1.2"
                app:thumbTint="#00E676"
                app:trackTint="#2E3B4E" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- סרגל ניווט קטגוריות (4 קטגוריות) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="#121722"
        android:orientation="horizontal"
        android:padding="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabBtnVolume"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="#00E676"
            android:text="עוצמה"
            android:textColor="#0B0E14"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabBtnQuality"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="#00000000"
            android:text="איכות HD"
            android:textColor="#A0AAB8"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabBtnEffects"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="#00000000"
            android:text="אפקטים"
            android:textColor="#A0AAB8"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabBtnEq"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="#00000000"
            android:text="אקולייזר"
            android:textColor="#A0AAB8"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ================= קטגוריה 1: עוצמה ומחוון מערכת ================= -->
            <LinearLayout
                android:id="@+id/sectionVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#161B26"
                    app:cardCornerRadius="24dp"
                    app:strokeColor="#00E676"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="עוצמת שמע ראשית (0% - 200%)"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvSubBoostInfo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="מערכת: 100% | הגברה נקייה: +0.0 dB"
                                    android:textColor="#A0AAB8"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvTotalVolume"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textColor="#00E676"
                                android:textSize="28sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressTotalVolume"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="14dp"
                            android:max="200"
                            android:progress="100"
                            android:progressBackgroundTint="#263042"
                            android:progressTint="#00E676" />

                        <SeekBar
                            android:id="@+id/seekTotalVolume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:max="200"
                            android:progress="100"
                            android:progressTint="#00E676"
                            android:thumbTint="#00E676" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVolMute"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:text="השתק"
                                android:textColor="#A0AAB8"
                                android:textSize="11sp"
                                app:cornerRadius="12dp"
                                app:strokeColor="#3A465E" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVol100"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:text="100%"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                app:cornerRadius="12dp"
                                app:strokeColor="#3A465E" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVol150"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:text="150%"
                                android:textColor="#FFD740"
                                android:textSize="11sp"
                                app:cornerRadius="12dp"
                                app:strokeColor="#FFD740" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVol200"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="200% MAX"
                                android:textColor="#FF5252"
                                android:textSize="11sp"
                                app:cornerRadius="12dp"
                                app:strokeColor="#FF5252" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- כרטיסיית חיבור למחוון המקורי של המכשיר -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A2234"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="סנכרון עם מחוון הווליום המקורי של המכשיר"
                            android:textColor="#00E5FF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="משאיר את המחוון המקורי של מערכת ההפעלה שלך בדיוק כפי שהוא (בכל סוגי המכשירים), ומרחיב אותו להגברה עד 200% מכל מסך."
                            android:textColor="#D0D8E8"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEnableSystemSlider"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#00E5FF"
                            android:text="הפעל הרחבת מחוון מערכת בהגדרות"
                            android:textColor="#0B0E14"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= קטגוריה 2: שיפור איכות הצליל (HD DSP) ================= -->
            <LinearLayout
                android:id="@+id/sectionQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#161B26"
                    app:cardCornerRadius="24dp"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="מנוע שמירה ושיפור איכות הסאונד (HD Audio)"
                            android:textColor="#00E5FF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp"
                            android:text="מונע חיתוך גלי קול (Clipping) וצרידות ברמקול בעת הגברה חזקה, ומשחזר תדרים גבוהים ועמוקים."
                            android:textColor="#A0AAB8"
                            android:textSize="12sp" />

                        <!-- מתג 1: Anti-Clipping Limiter -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Anti-Clipping Limiter (מניעת עיוותים)"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="מגן על איכות הצליל והרמקול בעוצמות של 100%-200%"
                                    android:textColor="#A0AAB8"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAntiClip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="#00E676" />
                        </LinearLayout>

                        <!-- מתג 2: Hi-Res Acoustic Optimizer -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Hi-Res Dynamic Range (ייצוב טווח דינמי)"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="מאזן בין צלילים חלשים לחזקים לשמיעה עשירה ונקייה"
                                    android:textColor="#A0AAB8"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchHiRes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                app:thumbTint="#00E5FF" />
                        </LinearLayout>

                        <!-- סליידר חדות וצלילות (Clarity Exciter) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Crystal Clarity (חדות וניקיון צליל)"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvClarityValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="50%"
                                android:textColor="#00E5FF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/seekClarity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="#00E5FF"
                            android:thumbTint="#00E5FF" />

                        <!-- סליידר חמימות באס טבעית (Warmth) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Harmonic Warmth (עומק וחמימות אקוסטית)"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvWarmthValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="40%"
                                android:textColor="#00E676"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/seekWarmth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progress="40"
                            android:progressTint="#00E676"
                            android:thumbTint="#00E676" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= קטגוריה 3: אפקטים אקוסטיים (3D & Bass) ================= -->
            <LinearLayout
                android:id="@+id/sectionEffects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B26"
                    app:cardCornerRadius="24dp"
                    app:strokeColor="#BB86FC"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="אפקטים אקוסטיים ומרחב (3D Studio)"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- באס -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Sub-Bass Boost (הדגשת תדרי באס)"
                                android:textColor="#D0D8E8"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvBassValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="#BB86FC"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/seekBass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="18dp"
                            android:max="1000"
                            android:progressTint="#BB86FC"
                            android:thumbTint="#BB86FC" />

                        <!-- סראונד 3D -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="3D Spatial Audio (סראונד מרחבי)"
                                android:textColor="#D0D8E8"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvVirtualizerValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textColor="#00E5FF"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/seekVirtualizer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="18dp"
                            android:max="1000"
                            android:progressTint="#00E5FF"
                            android:thumbTint="#00E5FF" />

                        <!-- Reverb -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Studio Reverb (אקוסטיקת אולם)"
                                android:textColor="#D0D8E8"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvReverbValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ללא"
                                android:textColor="#FFD740"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/seekReverb"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:max="6"
                            android:progress="0"
                            android:progressTint="#FFD740"
                            android:thumbTint="#FFD740" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= קטגוריה 4: אקולייזר ופרופילים ================= -->
            <LinearLayout
                android:id="@+id/sectionEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="פרופילי שמע מוכנים"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresetNormal"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="מאוזן"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#3A465E" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresetBass"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="באס כבד"
                        android:textColor="#BB86FC"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#BB86FC" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresetVocal"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="ווקאל HD"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#00E5FF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPresetGaming"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="גיימינג"
                        android:textColor="#00E676"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#00E676" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B26"
                    app:cardCornerRadius="24dp"
                    app:strokeColor="#263042"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="אקולייזר תדרים מדויק (Master EQ)"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/eqContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
 
