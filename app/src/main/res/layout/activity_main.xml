<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- כותרת עליונה ומתג הפעלה -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#161B26"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="#00E676"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOUND BOOSTER PRO"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="מנוע סאונד פעיל ●"
                        android:textColor="#00E676"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEnable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    app:thumbTint="#00E676"
                    app:trackTint="#2E3B4E" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- כרטיסיית הפעלת מחוון מערכת -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#1A2234"
            app:cardCornerRadius="20dp"
            app:strokeColor="#00E5FF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="מחוון ווליום מערכתי 1:1 (עד 200%)"
                    android:textColor="#00E5FF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="מחליף את מחוון המערכת בעיצוב מקורי מלא של המכשיר כולל חיווי בלוטות', מצבי צלצול וכפתור כתוביות/טורבו."
                    android:textColor="#D0D8E8"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableSystemSlider"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#00E5FF"
                    android:text="הפעל מחוון ווליום מערכתי בהגדרות"
                    android:textColor="#0B0E14"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- כרטיסיית בקרת ווליום המאוחדת 0% - 200% -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#161B26"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="#00E676"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="עוצמת שמע כוללת (עד 200%)"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubBoostInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="מערכת: 100% | תוספת: +0.0 dB"
                            android:textColor="#A0AAB8"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTotalVolume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#00E676"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressTotalVolume"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="14dp"
                    android:max="200"
                    android:progress="100"
                    android:progressTint="#00E676"
                    android:progressBackgroundTint="#263042" />

                <SeekBar
                    android:id="@+id/seekTotalVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="200"
                    android:progress="100"
                    android:progressTint="#00E676"
                    android:thumbTint="#00E676" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVolMute"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="השתק"
                        android:textColor="#A0AAB8"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#3A465E" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVol100"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="100%"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#3A465E" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVol150"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="150%"
                        android:textColor="#FFD740"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#FFD740" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVol200"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="200% MAX"
                        android:textColor="#FF5252"
                        android:textSize="11sp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#FF5252" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- כרטיסיית אפקטים: באס, סראונד ואקוסטיקת חדר -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#161B26"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="#263042"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="אפקטים אקוסטיים מתקדמים"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- באס -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sub-Bass Boost (הדגשת באס)"
                        android:textColor="#D0D8E8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBassValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#BB86FC"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp"
                    android:max="1000"
                    android:progressTint="#BB86FC"
                    android:thumbTint="#BB86FC" />

                <!-- סראונד 3D -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3D Spatial Audio (סראונד מרחבי)"
                        android:textColor="#D0D8E8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvVirtualizerValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#00E5FF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekVirtualizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp"
                    android:max="1000"
                    android:progressTint="#00E5FF"
                    android:thumbTint="#00E5FF" />

                <!-- אקוסטיקת חדר ואולם (Reverb) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Studio Reverb (אקוסטיקת אולם)"
                        android:textColor="#D0D8E8"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvReverbValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ללא"
                        android:textColor="#FFD740"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekReverb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="6"
                    android:progress="0"
                    android:progressTint="#FFD740"
                    android:thumbTint="#FFD740" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- פרופילים מוכנים -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="פרופילי שמע חכמים"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetNormal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="מאוזן"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="14dp"
                app:strokeColor="#3A465E" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetBass"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="באס כבד"
                android:textColor="#BB86FC"
                android:textSize="12sp"
                app:cornerRadius="14dp"
                app:strokeColor="#BB86FC" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetVocal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="ווקאל נקי"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                app:cornerRadius="14dp"
                app:strokeColor="#00E5FF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresetGaming"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="גיימינג"
                android:textColor="#00E676"
                android:textSize="12sp"
                app:cornerRadius="14dp"
                app:strokeColor="#00E676" />
        </LinearLayout>

        <!-- כרטיסיית אקולייזר -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#161B26"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="#263042"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="אקולייזר תדרים מדויק (Master EQ)"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/eqContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
 
