<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="Sound Booster Pro"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- שירות ההשתלטות על כפתורי הווליום, בועית ה-HD הנגררת וזיהוי אפליקציות -->
        <service
            android:name=".VolumeOverlayService"
            android:exported="true"
            android:label="Sound Booster מחוון ווליום 200%"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- אריח הגדרות מהירות בווילון ההתראות (Quick Settings Tile) -->
        <service
            android:name=".BoosterTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="Sound Booster HD"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- מקלט אוטומציה וקיצורי דרך (Tasker / Routines / Intent API) -->
        <receiver
            android:name=".AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.soundbooster.ACTION_SET_BOOST" />
                <action android:name="com.example.soundbooster.ACTION_TOGGLE_BOOSTER" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
 
